datadir="/var/lib/proxysql"

admin_variables=
{
  admin_credentials="admin:admin;radmin:radmin"
  mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
  threads=2
  interfaces="0.0.0.0:6033"
  monitor_username="root"
  monitor_password="rootpass"
}

mysql_servers=
(
  { address="mysql", port=3306, hostgroup=0, max_connections=100 },
  { address="mysql", port=3306, hostgroup=10, max_connections=100 }
)

mysql_users=
(
  { username="appuser", password="apppass", default_hostgroup=0, active=1 }
)

mysql_query_rules=
(
  { rule_id=1, active=1, match_digest="^SELECT.*FOR UPDATE", destination_hostgroup=0, apply=1 },
  { rule_id=2, active=1, match_digest="^SELECT", destination_hostgroup=10, apply=1 }
)
